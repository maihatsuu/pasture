{
	"schemaVersion": 1,
	"id": "pasture",
	"version": "${version}",
	"name": "Pasture",
	"description": "Animal products need upkeep: cows, goats and mooshrooms graze to refill their milk (collected in bottles), chickens drop eggs when bred instead of laying them, brushed armadillos need a day to regrow, and dispensers can feed animals.",
	"authors": [
		"maihatsuu"
	],
	"contact": {
		"sources": "https://github.com/maihatsuu/pasture"
	},
	"license": "CC0-1.0",
	"icon": "assets/pasture/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"maihatsuu.pasture.Pasture"
		],
		"client": [
			"maihatsuu.pasture.client.PastureClient"
		],
		"modmenu": [
			"maihatsuu.pasture.client.ModMenuIntegration"
		],
		"jade": [
			"maihatsuu.pasture.compat.PastureJadePlugin"
		]
	},
	"mixins": [
		"pasture.mixins.json",
		{
			"config": "pasture.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"jade": "*",
		"modmenu": "*",
		"cloth-config": "*"
	}
}
